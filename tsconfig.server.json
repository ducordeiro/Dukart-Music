{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist-web-server",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/server",
    "src/electron/database.ts",
    "src/electron/auth.ts",
    "src/electron/downloader.ts",
    "src/electron/env.ts",
    "src/electron/youtubeSearch.ts",
    "src/shared"
  ]
}
