YOUTUBE_API_KEY=cole_sua_chave_aqui

# Desktop usa este backend para contas, playlists e favoritos.
# `npm run dev` usa o backend publicado; `npm run dev:local` usa localhost.
ESPORTE_FAI_API_URL=https://e.duk4rt.com
ESPORTE_FAI_CANONICAL_HOST=e.duk4rt.com
ESPORTE_FAI_LEGACY_HOST=duk4rt.com

# Suporte aos PO Tokens exigidos pelo YouTube para downloads. O instalador
# migration-tools/INSTALL_YOUTUBE_DOWNLOAD_SUPPORT.ps1 configura estes caminhos
# automaticamente quando as ferramentas ficam em .server-tools.
# ESPORTE_FAI_YTDLP_PLUGIN_DIR=C:\caminho\do\projeto\.server-tools\yt-dlp-plugins
# ESPORTE_FAI_YTDLP_PROVIDER_HOME=C:\caminho\do\projeto\.server-tools\bgutil-ytdlp-pot-provider\server
# ESPORTE_FAI_YOUTUBE_PLAYER_CLIENT=web_embedded
