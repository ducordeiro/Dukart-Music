YOUTUBE_API_KEY=cole_sua_chave_aqui

# Desktop usa este backend para contas, playlists e favoritos.
# `npm run dev` usa o backend publicado; `npm run dev:local` usa localhost.
ESPORTE_FAI_API_URL=https://e.duk4rt.com
ESPORTE_FAI_CANONICAL_HOST=e.duk4rt.com
ESPORTE_FAI_LEGACY_HOST=duk4rt.com

# Mantenha o banco central separado do banco local usado pelo Electron.
# ESPORTE_FAI_DB_PATH=C:\Users\SEU_USUARIO\AppData\Roaming\esporte-fai-server\esporte_fai_central.sqlite
ESPORTE_FAI_MIN_FREE_BYTES=2147483648
ESPORTE_FAI_MAX_MEDIA_BYTES=21474836480
ESPORTE_FAI_MAX_DOWNLOADS_PER_USER=500
ESPORTE_FAI_RETENTION_REPORT_DAYS=30
